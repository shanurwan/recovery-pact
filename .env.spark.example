# For compose.spark.yaml. Copy to .env.spark and fill in; no API key is needed.
# The NGC vLLM container built for DGX Spark (arm64, Blackwell), from catalog.ngc.nvidia.com.
SPARK_VLLM_IMAGE=
# Folder holding the checkpoints below, mounted read-only at /models.
SPARK_MODELS_DIR=./models
# Folder names inside SPARK_MODELS_DIR. FP4 for Super VL and Lightning, BF16 for the rest.
SPARK_SUPER_WEIGHTS=
SPARK_LIGHTNING_WEIGHTS=
SPARK_SAFETY_GUARD_WEIGHTS=
SPARK_CONTENT_SAFETY_WEIGHTS=
SPARK_EMBED_WEIGHTS=
