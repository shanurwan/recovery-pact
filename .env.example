# RecoveryPact environment — copy to .env and fill secrets locally.
# Base infra and deterministic tests run WITHOUT these secrets.

# --- Core ---
APP_ENV=development
LOG_LEVEL=INFO
DATABASE_URL=postgresql+psycopg://checkout:checkout@postgres:5432/checkout
OBSERVER_DATABASE_URL=postgresql+psycopg://observer:observer@postgres:5432/checkout
EXECUTOR_DATABASE_URL=postgresql+psycopg://remediator:remediator@postgres:5432/checkout
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:8080,http://localhost:3000

# --- Inference (NVIDIA NIM / Nemotron) ---
# Official OpenAI-compatible endpoint: https://integrate.api.nvidia.com/v1
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NEMOTRON_MODEL=nvidia/nemotron-3-nano-30b-a3b
INFERENCE_MODE=fixture
# INFERENCE_MODE=nemotron  # requires NVIDIA_API_KEY
INFERENCE_TIMEOUT_SECONDS=60
INFERENCE_MAX_RETRIES=2
INFERENCE_TEMPERATURE=0.2

# --- Zetaris (optional live federation) ---
ZETARIS_ENABLED=false
ZETARIS_URL=
ZETARIS_EMAIL=
ZETARIS_PASSWORD=
ZETARIS_TARGET_ROLE=
# When false/unavailable, LocalFederatedEvidence fallback is used and labeled.

# --- H-MEM ---
HMEM_PERSIST_DIR=/app/data/hmem
HMEM_ENABLED=true

# --- Negotiation ---
NEGOTIATION_MAX_ROUNDS=4
NEGOTIATION_TIMEOUT_SECONDS=120

# --- Authority ---
AUTHORITY_TTL_SECONDS=120
AUTHORITY_MAX_EXECUTIONS=1
SIMULATED_HUMAN_APPROVAL_LATENCY_MS=30000

# --- Demo ---
CHECKOUT_TIMEOUT_MS=3000
TRAFFIC_RPS=2
