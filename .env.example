# RecoveryPact environment. Copy to .env and fill in locally. Never commit .env.
# With no values at all, the stack still runs: replay mode + local business fallback.

# --- NVIDIA Nemotron (https://build.nvidia.com, free key) ---
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# Ultra runs the demo, the recorded replays and the benchmark.
NEMOTRON_MODEL=nvidia/nemotron-3-ultra-550b-a55b
# NEMOTRON_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b   # benchmark comparison
# NEMOTRON_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b    # fast iteration while building
NEMOTRON_THINKING=false
# nemotron = live calls (recorded under data/recordings)
# replay   = recorded Nemotron responses shipped in recordings/ (no key needed)
INFERENCE_MODE=nemotron
EMBEDDING_MODEL=nvidia/nemotron-3-embed-1b

# --- Zetaris (live federation; see scripts/zetaris-setup.sh) ---
# Leave ZETARIS_ENABLED=false to answer the same questions locally, clearly labeled.
ZETARIS_ENABLED=false
ZETARIS_URL=http://zetaris-ui-1:3000
ZETARIS_EMAIL=admin@zetaris.com
ZETARIS_PASSWORD=
ZETARIS_ORG_ID=1

# --- Meterless H-MEM ---
HMEM_ENABLED=true
HMEM_RECALL_THRESHOLD=0.30

# --- Negotiation and authority ---
NEGOTIATION_MAX_ROUNDS=3
NEGOTIATION_TIMEOUT_SECONDS=240
AUTHORITY_TTL_SECONDS=120

# --- Demo ---
TRAFFIC_RPS=4
UI_PORT=8080
