# RecoveryPact environment. Copy to .env and fill in locally. Never commit .env.
# With no values at all, the stack still runs: replay mode + local business fallback.

# --- AI provider: Meterless Runtime (Nightshift) is the primary provider ---
# Nightshift serves the Nemotron models assigned to its lanes. Put your NVIDIA key in
# Nightshift's Setup > Providers tab, not here. Copy the Runtime URL and API key from
# the Nightshift Console. From inside Docker, a Nightshift on the same machine is
# http://host.docker.internal:8088/v1.
AI_PROVIDER=meterless
METERLESS_BASE_URL=http://host.docker.internal:8088/v1
METERLESS_RUNTIME_TOKEN=your-nightshift-runtime-token-here
METERLESS_MODEL=meterless/auto
# Pin roles to Nemotron lanes (use the ids GET /v1/models lists), e.g.
# METERLESS_ROUTES=nvidia/nemotron-3.5-lightning-30b-a3b=meterless/fast,nvidia/nemotron-3-super-120b-a12b=meterless/deep
METERLESS_ROUTES=
# Check the connection: docker compose exec api python -m app.integrations.meterless.runtime
# Rule I8, signed provenance: the authority acts only on answers Nightshift signed.
# Run scripts/nightshift-receipt-relay.py next to Nightshift; pin Nightshift's public key
# (the pubkey_b64 of any receipt, or its 16-hex fingerprint). Unset key = fail closed.
RECEIPT_GATE=false
METERLESS_RECEIPTS_URL=http://host.docker.internal:8099
METERLESS_RECEIPT_KEY=
# Lanes: the Nemotron models allowed to answer each role; a receipt naming any other model is
# refused (Nightshift can substitute a model on a route). Separate models with |, roles with commas.
# RECEIPT_LANES=database_guardian=nvidia/nemotron-3.5-super-vl-120b-a12b|nvidia/nemotron-3-ultra-550b-a55b,continuity_guardian=nvidia/nemotron-3.5-super-vl-120b-a12b|nvidia/nemotron-3-ultra-550b-a55b
RECEIPT_LANES=

# --- Direct NVIDIA NIM (alternative provider: AI_PROVIDER=nvidia; https://build.nvidia.com) ---
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# Ultra runs the demo, the recorded replays and the benchmark.
NEMOTRON_MODEL=nvidia/nemotron-3-ultra-550b-a55b
# NEMOTRON_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b   # benchmark comparison
# NEMOTRON_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b    # fast iteration while building
NEMOTRON_THINKING=false
# nemotron = live calls (recorded under data/recordings)
# replay   = recorded Nemotron responses shipped in recordings/ (no key needed)
INFERENCE_MODE=nemotron
EMBEDDING_MODEL=nvidia/nemotron-3-embed-1b
# Injection-guard models served on this machine (llama.cpp or any OpenAI-compatible server), so
# untrusted production text never leaves it. Empty = the NVIDIA API.
# GUARD_LOCAL=nvidia/nemotron-3.5-content-safety=http://127.0.0.1:8091/v1,nvidia/llama-3.1-nemotron-safety-guard-8b-v3=http://127.0.0.1:8092/v1
GUARD_LOCAL=

# --- Zetaris (live federation; see scripts/zetaris-setup.sh) ---
# Leave ZETARIS_ENABLED=false to answer the same questions locally, clearly labeled.
ZETARIS_ENABLED=false
ZETARIS_URL=http://zetaris-ui-1:3000
ZETARIS_EMAIL=admin@zetaris.com
ZETARIS_PASSWORD=
ZETARIS_ORG_ID=1
# views = ask the registered sources; usl = ask the semantic layer recovery_business and gate
# kills on its data-quality rules (invariant I9). scripts/zetaris-setup.sh builds both.
ZETARIS_QUERY_LAYER=views

# --- Meterless H-MEM ---
HMEM_ENABLED=true
HMEM_RECALL_THRESHOLD=0.30

# --- Negotiation and authority ---
NEGOTIATION_MAX_ROUNDS=3
NEGOTIATION_TIMEOUT_SECONDS=240
AUTHORITY_TTL_SECONDS=120
# Jobs onboarded onto the authority's static terminate allowlist (comma-separated).
AUTHORITY_EXTRA_APPS=

# --- Runtime behaviour ---
# SAMPLE_MODE=true replays recorded Nemotron decisions: no key, no model network.
SAMPLE_MODE=false
LOG_LEVEL=INFO

# --- Demo ---
TRAFFIC_RPS=4
UI_PORT=8080
